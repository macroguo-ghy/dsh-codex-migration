{
  "name": "dsh-codex-migration",
  "version": "0.3.1",
  "description": "Import Codex conversations into DeepSeek Harness",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client-bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15",
    "dsh": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepack": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "dsh-codex-cleanup": "./src/cleanup.js"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.26",
    "typescript": "^5.9.3"
  }
}
